---
import { experiments } from "../data/content";
import SectionHeading from "./SectionHeading.astro";

const statusStyles: Record<string, string> = {
  shipped: "text-emerald-600 dark:text-emerald-400",
  "in progress": "text-amber-600 dark:text-amber-400",
  idea: "text-zinc-400 dark:text-zinc-500",
  paused: "text-zinc-400 dark:text-zinc-500",
};
---

<section id="experiments" class="py-20">
  <SectionHeading path="experiments" title={experiments.title} />
  <p class="max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
    {experiments.description}
  </p>
  <p class="mt-2 font-mono text-xs text-zinc-400 dark:text-zinc-500">
    // {experiments.note}
  </p>

  <ul class="mt-10 divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
    {
      experiments.items.map((exp) => (
        <li class="py-7 first:pt-0">
          <div class="flex flex-wrap items-baseline gap-x-3">
            <h3 class="text-lg font-semibold">
              {exp.link ? (
                <a
                  href={exp.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline-offset-4 hover:text-indigo-600 hover:underline dark:hover:text-indigo-400"
                >
                  {exp.title}
                  <span class="text-indigo-500"> ↗</span>
                </a>
              ) : (
                exp.title
              )}
            </h3>
            <span class={`font-mono text-xs ${statusStyles[exp.status]}`}>
              {exp.status}
            </span>
          </div>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {exp.story}
          </p>
          {exp.tech && exp.tech.length > 0 && (
            <p class="mt-3 font-mono text-xs text-zinc-400 dark:text-zinc-500">
              {exp.tech.join(" · ")}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</section>
