---
import { profile } from "../data/content";

const year = new Date().getFullYear();

const links = [
  { href: profile.socials.github, label: "GitHub" },
  { href: profile.socials.linkedin, label: "LinkedIn" },
  { href: profile.socials.twitter, label: "Twitter" },
].filter((l) => l.href);
---

<footer class="border-t border-zinc-200 py-8 dark:border-zinc-800">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-4 px-6 sm:flex-row"
  >
    <p class="text-sm text-zinc-500 dark:text-zinc-400">
      © {year} {profile.name}
    </p>
    {
      links.length > 0 && (
        <ul class="flex gap-4">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
