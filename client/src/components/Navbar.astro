---
import { existsSync } from "node:fs";
import { join } from "node:path";
import ThemeToggle from "../islands/ThemeToggle";
import { profile } from "../data/content";

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/#experience", label: "Experience" },
  { href: "/#contact", label: "Contact" },
];

const photoSrc = existsSync(join(process.cwd(), "public", "me.jpg"))
  ? "/me.jpg"
  : null;
const initial = profile.name.charAt(0).toUpperCase();
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-zinc-200/60 bg-white/80 backdrop-blur dark:border-zinc-800/60 dark:bg-zinc-950/80"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center gap-2.5">
      {
        photoSrc ? (
          <img
            src={photoSrc}
            alt=""
            class="h-8 w-8 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-700"
          />
        ) : (
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-xs font-bold text-white"
            aria-hidden="true"
          >
            {initial}
          </span>
        )
      }
      <span class="font-mono text-sm font-semibold tracking-tight">
        {profile.name}
      </span>
    </a>

    <p
      id="crumb"
      aria-hidden="true"
      class="absolute left-1/2 hidden -translate-x-1/2 font-mono text-xs text-zinc-400 sm:block dark:text-zinc-500"
    >
      ~
    </p>

    <div class="flex items-center gap-1 sm:gap-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hidden font-mono text-xs uppercase tracking-wider text-zinc-500 transition-colors hover:text-indigo-600 sm:block dark:text-zinc-400 dark:hover:text-indigo-400"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle client:load />
    </div>
  </nav>

  <div
    id="scroll-progress"
    class="absolute -bottom-px left-0 h-[2px] w-full origin-left scale-x-0 bg-indigo-500"
  >
  </div>
</header>

<script>
  const bar = document.getElementById("scroll-progress")!;
  const crumb = document.getElementById("crumb")!;
  const sections = [...document.querySelectorAll("main section[id]")];
  const perspLinks = document.querySelectorAll("[data-perspective]");

  function update() {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;

    let currentId = "top";
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= innerHeight * 0.35) {
        currentId = section.id;
      }
    }
    crumb.textContent =
      currentId !== "top"
        ? `~/${currentId}`
        : location.pathname === "/"
          ? "~"
          : `~${location.pathname.replace(/\/$/, "")}`;

    for (const link of perspLinks) {
      const active = (link as HTMLElement).dataset.perspective === currentId;
      link.classList.toggle("text-indigo-600", active);
      link.classList.toggle("dark:text-indigo-400", active);
      link.classList.toggle("underline", active);
      link.classList.toggle("text-zinc-500", !active);
      link.classList.toggle("dark:text-zinc-400", !active);
    }
  }

  addEventListener("scroll", update, { passive: true });
  update();
</script>
