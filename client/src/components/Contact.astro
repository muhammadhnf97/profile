---
import { contact, profile } from "../data/content";
import ContactForm from "../islands/ContactForm";
import SectionHeading from "./SectionHeading.astro";

const links = [
  { href: `mailto:${profile.email}`, label: "email", external: false },
  { href: profile.socials.github, label: "github", external: true },
  { href: profile.socials.linkedin, label: "linkedin", external: true },
  { href: profile.socials.twitter, label: "twitter", external: true },
  { href: profile.socials.resume, label: "resume", external: true },
].filter((l) => l.href);
---

<section id="contact" class="py-20">
  <SectionHeading path="contact" title={contact.heading} />
  <div class="max-w-xl">
    {
      links.length > 0 && (
        <ul class="mb-8 flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="text-zinc-600 transition-colors hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400"
              >
                {link.label}
                {link.external && <span class="text-indigo-500"> ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <ContactForm client:load />
  </div>
</section>
