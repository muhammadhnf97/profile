---
import { technicalGrowth } from "../data/content";
import AreaBlock from "./AreaBlock.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="technical-growth" class="py-20">
  <SectionHeading path="technical-growth" title={technicalGrowth.title} />
  <p class="max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
    {technicalGrowth.description}
  </p>

  <div
    class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-dashed border-zinc-300 py-5 font-mono text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400"
  >
    <span>engineering</span>
    <span class="text-indigo-500">──▶</span>
    <span class="font-semibold text-zinc-900 dark:text-zinc-100"
      >technical growth</span
    >
    <span class="text-indigo-500">◀──</span>
    <span>digital & growth</span>
  </div>

  <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {technicalGrowth.areas.map((area) => <AreaBlock area={area} />)}
  </div>

  <p class="mt-10 max-w-2xl text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
    {technicalGrowth.proof}
  </p>
</section>
