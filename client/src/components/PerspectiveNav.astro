---
import { perspectives } from "../data/content";
---

<nav
  id="perspective-nav"
  class="sticky top-20 z-40 hidden -translate-y-2 justify-center opacity-0 transition-all duration-300 sm:flex"
  aria-label="Perspectives"
>
  <div
    class="flex items-baseline rounded-full border border-zinc-200/70 bg-white/80 px-5 py-2 font-mono text-sm shadow-sm backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80"
  >
    {
      perspectives.map((p, i) => (
        <>
          {i > 0 && <span class="mx-3 text-zinc-300 dark:text-zinc-700">/</span>}
          <a
            href={`#${p.id}`}
            data-perspective={p.id}
            class="text-zinc-500 underline-offset-4 transition-colors hover:text-indigo-600 hover:underline dark:text-zinc-400 dark:hover:text-indigo-400"
          >
            {p.label.toLowerCase()}
          </a>
        </>
      ))
    }
  </div>
</nav>

<script>
  const nav = document.getElementById("perspective-nav");
  const hero = document.getElementById("top");

  if (nav && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle("opacity-0", entry.isIntersecting);
        nav.classList.toggle("-translate-y-2", entry.isIntersecting);
        nav.classList.toggle("pointer-events-none", entry.isIntersecting);
      },
      { threshold: 0 }
    );
    observer.observe(hero);
  }
</script>
